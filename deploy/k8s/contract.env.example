# kubectl create secret generic tradepass-contract --from-env-file=<private-copy> -n tradepass-staging
TRADEPASS_DATABASE_URL=jdbc:mysql://mysql.internal:3306/tradepass_staging_contract?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
DB_USERNAME=tradepass_contract
DB_PASSWORD=replace-with-independent-contract-password
XXL_JOB_ACCESS_TOKEN=replace-with-independent-random-token-at-least-32-characters
ROCKETMQ_ACCESS_KEY=
ROCKETMQ_SECRET_KEY=
FADADA_ENABLED=false
FADADA_APP_ID=
FADADA_APP_SECRET=
# Optional application-owner default binding: set all four only after verifying it for FADADA_APP_ID.
FADADA_OWNER_ENTERPRISE_APP_ID=
FADADA_OWNER_ENTERPRISE_OPEN_CORP_ID=
FADADA_OWNER_ENTERPRISE_CREDIT_CODE=
FADADA_OWNER_ENTERPRISE_CLIENT_CORP_ID=
