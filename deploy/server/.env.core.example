# Copy to a private .env.core. Keep existing passwords/volume project names during cutover.
# Generate EACH database password with: openssl rand -hex 32
MYSQL_ROOT_PASSWORD=
IDENTITY_DATABASE_URL='jdbc:mysql://127.0.0.1:3306/tradepass_staging_identity?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai'
IDENTITY_DB_USERNAME=tradepass_identity
IDENTITY_DB_PASSWORD=
BUSINESS_DATABASE_URL='jdbc:mysql://127.0.0.1:3306/tradepass_staging_business?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai'
BUSINESS_DB_USERNAME=tradepass_business
BUSINESS_DB_PASSWORD=
REDIS_PASSWORD=
MYSQL_PORT=3306
REDIS_PUBLISH_PORT=6379
TRADEPASS_REDIS_ENABLED=false
TRADEPASS_NETWORK_NAME=tradepass-server
TRADEPASS_IMAGE_TAG=local
TRADEPASS_INTERNAL_KEY=
TRADEPASS_IDS_DATACENTER_ID=2
TRADEPASS_LOG_DIRECTORY=/docker/tradepass/logs
# Docker Nginx: absolute directory containing fullchain.pem and privkey.pem.
TRADEPASS_TLS_DIRECTORY=
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=
NACOS_GROUP=TRADEPASS_CORE
NACOS_USERNAME=nacos
# Set the admin password in the Nacos console first; this variable is used by clients.
NACOS_PASSWORD=
# openssl rand -base64 32
NACOS_AUTH_TOKEN=
# openssl rand -hex 32
NACOS_AUTH_IDENTITY_VALUE=
ROCKETMQ_CALLBACK_TOPIC=tradepass-callback-events
ROCKETMQ_ACCESS_KEY=
ROCKETMQ_SECRET_KEY=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
FADADA_ENABLED=false
FADADA_APP_ID=
FADADA_APP_SECRET=
FADADA_SERVER_URL=https://api.fadada.com/api/v5
FADADA_CALLBACK_URL=
TRADEPASS_STORAGE_PROVIDER=cloudbase-cos
TRADEPASS_STORAGE_ENABLED=false
TRADEPASS_STORAGE_REQUIRED=false
CLOUDBASE_STORAGE_BUCKET=
CLOUDBASE_STORAGE_REGION=ap-shanghai
OSS_ENDPOINT=
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SESSION_TOKEN=
TRADEPASS_LEGACY_COS_BUCKET=
TRADEPASS_LEGACY_COS_REGION=ap-shanghai
TRADEPASS_LEGACY_COS_KEY_PREFIX=tradepass
TRADEPASS_LEGACY_COS_SECRET_ID=
TRADEPASS_LEGACY_COS_SECRET_KEY=
TRADEPASS_LEGACY_COS_SESSION_TOKEN=
