# Each service owns a separate schema and a separately granted MySQL account.
IDENTITY_DATABASE_URL=jdbc:mysql://mysql:3306/tradepass_staging_identity?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
IDENTITY_DB_USERNAME=tradepass_identity
IDENTITY_DB_PASSWORD=replace-with-independent-identity-password
CONTRACT_DATABASE_URL=jdbc:mysql://mysql:3306/tradepass_staging_contract?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
CONTRACT_DB_USERNAME=tradepass_contract
CONTRACT_DB_PASSWORD=replace-with-independent-contract-password
TRADE_DATABASE_URL=jdbc:mysql://mysql:3306/tradepass_staging_trade?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
TRADE_DB_USERNAME=tradepass_trade
TRADE_DB_PASSWORD=replace-with-independent-trade-password
SETTLEMENT_DATABASE_URL=jdbc:mysql://mysql:3306/tradepass_staging_settlement?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
SETTLEMENT_DB_USERNAME=tradepass_settlement
SETTLEMENT_DB_PASSWORD=replace-with-independent-settlement-password
SEATA_SERVER_ADDR=seata:8091
SEATA_CONSOLE_USERNAME=tradepass
SEATA_CONSOLE_PASSWORD=replace-with-unique-console-password
SEATA_SECURITY_SECRET_KEY=replace-with-base64-encoded-32-byte-random-key
TRADEPASS_CONTRACT_PROFILES=observability,messaging,jobs
ROCKETMQ_NAME_SERVER=rocketmq-namesrv:9876
ROCKETMQ_CALLBACK_TOPIC=tradepass-callback-events
ROCKETMQ_ACCESS_KEY=
ROCKETMQ_SECRET_KEY=
XXL_JOB_ADMIN_ADDRESSES=http://xxl-job-admin:8080/xxl-job-admin
XXL_JOB_ACCESS_TOKEN=replace-with-independent-random-token-at-least-32-characters
XXL_JOB_DB_PASSWORD=replace-with-independent-scheduler-password
# Copy to .env once, fill every password/token, then keep the same file.
# Generate each secret independently, for example: openssl rand -hex 32
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=
TRADEPASS_INTERNAL_KEY=

TRADEPASS_NETWORK_NAME=tradepass-server
TRADEPASS_IDS_DATACENTER_ID=2
TRADEPASS_IMAGE_TAG=local
TRADEPASS_GATEWAY_BIND=127.0.0.1
TRADEPASS_GATEWAY_PORT=1110

# Infrastructure Redis runs, but application caching retains its original default.
TRADEPASS_REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
WECHAT_APP_ID=
WECHAT_APP_SECRET=
FADADA_ENABLED=false
FADADA_APP_ID=
FADADA_APP_SECRET=
FADADA_SERVER_URL=https://api.fadada.com/api/v5
FADADA_CALLBACK_URL=

# Initial staging only. Configure the OSS adapter before enabling required storage.
TRADEPASS_STORAGE_ENABLED=false
TRADEPASS_STORAGE_REQUIRED=false
CLOUDBASE_STORAGE_BUCKET=
CLOUDBASE_STORAGE_REGION=ap-shanghai

# Optional backend governance (see docs/server-microservices-cutover.md).
TRADEPASS_SERVICE_PROFILES=observability
NACOS_SERVER_ADDR=nacos:8848
NACOS_NAMESPACE=
NACOS_GROUP=TRADEPASS
NACOS_USERNAME=
NACOS_PASSWORD=
SENTINEL_DASHBOARD=
# Enable storage in all business containers, and pass cloud credentials only to file.
TRADEPASS_STORAGE_PROVIDER=cloudbase-cos
OSS_ENDPOINT=
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SESSION_TOKEN=
TRADEPASS_LEGACY_COS_BUCKET=
TRADEPASS_LEGACY_COS_REGION=ap-shanghai
TRADEPASS_LEGACY_COS_KEY_PREFIX=tradepass
TRADEPASS_LEGACY_COS_SECRET_ID=
TRADEPASS_LEGACY_COS_SECRET_KEY=
TRADEPASS_LEGACY_COS_SESSION_TOKEN=
XXL_JOB_ADMIN_PASSWORD=replace-with-64-character-random-hex-password
