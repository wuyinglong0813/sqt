[Unit]
Description=TradePass retained-image and build-cache maintenance
Requisite=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Environment=TZ=Asia/Shanghai
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=30min
ExecStart=/usr/bin/python3 /usr/local/lib/tradepass-maintenance/maintenance.py --history-dir /docker/tradepass/jenkins/jenkins --apply --min-image-age-hours 24 --cache-age-hours 24 --cache-keep-storage 4GB
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tradepass-maintenance
