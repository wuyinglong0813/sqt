# Each service owns a separate schema and a separately granted MySQL account.
IDENTITY_DATABASE_URL=jdbc:mysql://host.docker.internal:1118/tradepass_staging_identity?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
IDENTITY_DB_USERNAME=tradepass_identity
IDENTITY_DB_PASSWORD=replace-with-independent-identity-password
CONTRACT_DATABASE_URL=jdbc:mysql://host.docker.internal:1118/tradepass_staging_contract?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
CONTRACT_DB_USERNAME=tradepass_contract
CONTRACT_DB_PASSWORD=replace-with-independent-contract-password
TRADE_DATABASE_URL=jdbc:mysql://host.docker.internal:1118/tradepass_staging_trade?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
TRADE_DB_USERNAME=tradepass_trade
TRADE_DB_PASSWORD=replace-with-independent-trade-password
SETTLEMENT_DATABASE_URL=jdbc:mysql://host.docker.internal:1118/tradepass_staging_settlement?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
SETTLEMENT_DB_USERNAME=tradepass_settlement
SETTLEMENT_DB_PASSWORD=replace-with-independent-settlement-password
SEATA_SERVER_ADDR=seata:8091
SEATA_CONSOLE_USERNAME=tradepass
SEATA_CONSOLE_PASSWORD=replace-with-unique-console-password
SEATA_SECURITY_SECRET_KEY=replace-with-base64-encoded-32-byte-random-key
TRADEPASS_CONTRACT_PROFILES=observability,messaging,jobs
ROCKETMQ_NAME_SERVER=rocketmq-namesrv:9876
ROCKETMQ_CALLBACK_TOPIC=tradepass-callback-events
ROCKETMQ_ACCESS_KEY=
ROCKETMQ_SECRET_KEY=
XXL_JOB_ADMIN_ADDRESSES=http://xxl-job-admin:8080/xxl-job-admin
XXL_JOB_ACCESS_TOKEN=replace-with-independent-random-token-at-least-32-characters
XXL_JOB_DB_PASSWORD=replace-with-independent-scheduler-password
# Copy to .env in this directory. Use four owned schemas; migrate historical V36 data with database-migrator.
# Generate independently for each environment: openssl rand -hex 32
TRADEPASS_INTERNAL_KEY=replace-with-a-random-value-at-least-32-characters
TRADEPASS_IMAGE_TAG=local
TRADEPASS_GATEWAY_BIND=127.0.0.1
TRADEPASS_GATEWAY_PORT=1110
TRADEPASS_IDS_DATACENTER_ID=1
GRAFANA_ADMIN_PASSWORD=replace-with-a-unique-password
# Optional Redis. host.docker.internal reaches a Redis instance on the Docker host.
TRADEPASS_REDIS_ENABLED=false
REDIS_HOST=host.docker.internal
REDIS_PORT=1119
REDIS_PASSWORD=
# WeChat login on a self-hosted server uses the app secret, without trusted CloudBase headers.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Local verification defaults to the original MySQL BLOB path.
# Server migration: enable storage and select aliyun-oss after configuring the private OSS bucket.
TRADEPASS_STORAGE_ENABLED=false
TRADEPASS_STORAGE_REQUIRED=false
TRADEPASS_STORAGE_PROVIDER=cloudbase-cos
CLOUDBASE_STORAGE_BUCKET=
CLOUDBASE_STORAGE_REGION=ap-shanghai
OSS_ENDPOINT=
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SESSION_TOKEN=
# Optional historical COS reads using a read-only credential, without CloudBase OpenAPI.
TRADEPASS_LEGACY_COS_BUCKET=
TRADEPASS_LEGACY_COS_REGION=ap-shanghai
TRADEPASS_LEGACY_COS_KEY_PREFIX=tradepass
TRADEPASS_LEGACY_COS_SECRET_ID=
TRADEPASS_LEGACY_COS_SECRET_KEY=
TRADEPASS_LEGACY_COS_SESSION_TOKEN=
# Enable after importing deploy/microservices/nacos configuration into the target namespace/group.
# All six processes must be reachable through their registered container/private-network addresses.
TRADEPASS_SERVICE_PROFILES=observability
# For service discovery and protection: observability,nacos,sentinel
NACOS_SERVER_ADDR=host.docker.internal:8848
NACOS_NAMESPACE=
NACOS_GROUP=TRADEPASS
NACOS_USERNAME=
NACOS_PASSWORD=
SENTINEL_DASHBOARD=
FADADA_ENABLED=false
FADADA_APP_ID=
FADADA_APP_SECRET=
FADADA_SERVER_URL=https://api.fadada.com/api/v5
FADADA_CALLBACK_URL=
XXL_JOB_ADMIN_PASSWORD=replace-with-64-character-random-hex-password
