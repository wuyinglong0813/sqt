    {
      "name": "05 合同签署（会创建真实任务，逐项手动调用）",
      "item": [
        {
          "name": "创建双方合同签署任务",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": "{{fdd_base_url}}/sign-task/create",
            "description": "样例以供方发起，PDF 必须包含“供方盖章”“需方盖章”。印章 ID 保留字符串避免 JavaScript 大整数精度损失。直接调用不经过商签通权限/合同快照流程。",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "bizContent",
                  "value": "{\n  \"initiator\": {\n    \"idType\": \"corp\",\n    \"openId\": \"{{supplier_open_corp_id}}\"\n  },\n  \"signTaskSubject\": \"{{subject}}\",\n  \"signDocType\": \"contract\",\n  \"autoStart\": true,\n  \"autoFinish\": true,\n  \"autoFillFinalize\": true,\n  \"signInOrder\": true,\n  \"fileFormat\": \"pdf\",\n  \"transReferenceId\": \"{{contract_reference}}\",\n  \"callbackUrl\": \"{{callback_url}}\",\n  \"docs\": [\n    {\n      \"docId\": \"contract-doc\",\n      \"docName\": \"{{file_name}}\",\n      \"docFileId\": \"{{file_id}}\",\n      \"docFields\": [\n        {\n          \"fieldId\": \"supplier-seal\",\n          \"fieldName\": \"供方盖章\",\n          \"position\": {\n            \"positionMode\": \"keyword\",\n            \"positionKeyword\": \"供方盖章\",\n            \"keywordOffsetX\": \"0\",\n            \"keywordOffsetY\": \"0\"\n          },\n          \"fieldType\": \"corp_seal\",\n          \"fieldCorpSeal\": {\n            \"width\": 42,\n            \"height\": 42,\n            \"followSignSize\": true\n          },\n          \"moveable\": false\n        },\n        {\n          \"fieldId\": \"buyer-seal\",\n          \"fieldName\": \"需方盖章\",\n          \"position\": {\n            \"positionMode\": \"keyword\",\n            \"positionKeyword\": \"需方盖章\",\n            \"keywordOffsetX\": \"0\",\n            \"keywordOffsetY\": \"0\"\n          },\n          \"fieldType\": \"corp_seal\",\n          \"fieldCorpSeal\": {\n            \"width\": 42,\n            \"height\": 42,\n            \"followSignSize\": true\n          },\n          \"moveable\": false\n        }\n      ]\n    }\n  ],\n  \"actors\": [\n    {\n      \"actor\": {\n        \"actorId\": \"supplier\",\n        \"actorType\": \"corp\",\n        \"actorName\": \"{{supplier_name}}\",\n        \"permissions\": [\n          \"sign\"\n        ],\n        \"actorOpenId\": \"{{supplier_open_corp_id}}\",\n        \"sendNotification\": false,\n        \"sendInSiteMessage\": false\n      },\n      \"signFields\": [\n        {\n          \"fieldDocId\": \"contract-doc\",\n          \"fieldId\": \"supplier-seal\",\n          \"fieldName\": \"supplier-seal\",\n          \"sealId\": \"{{supplier_seal_id}}\",\n          \"moveable\": false\n        }\n      ],\n      \"signConfigInfo\": {\n        \"orderNo\": 1,\n        \"requestVerifyFree\": false,\n        \"readingToEnd\": true,\n        \"resizeSeal\": false\n      }\n    },\n    {\n      \"actor\": {\n        \"actorId\": \"buyer\",\n        \"actorType\": \"corp\",\n        \"actorName\": \"{{buyer_name}}\",\n        \"permissions\": [\n          \"sign\"\n        ],\n        \"actorOpenId\": \"{{buyer_open_corp_id}}\",\n        \"sendNotification\": false,\n        \"sendInSiteMessage\": false\n      },\n      \"signFields\": [\n        {\n          \"fieldDocId\": \"contract-doc\",\n          \"fieldId\": \"buyer-seal\",\n          \"fieldName\": \"buyer-seal\",\n          \"sealId\": \"{{buyer_seal_id}}\",\n          \"moveable\": false\n        }\n      ],\n      \"signConfigInfo\": {\n        \"orderNo\": 2,\n        \"requestVerifyFree\": false,\n        \"readingToEnd\": true,\n        \"resizeSeal\": false\n      }\n    }\n  ]\n}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('法大大调用成功', () => pm.expect(String(r.code)).to.eql('100000'));",
                  "if (String(r.code) === '100000' && r.data) {",
                  "  if (r.data.signTaskId !== undefined && r.data.signTaskId !== null) pm.environment.set('sign_task_id', String(r.data.signTaskId));",
                  "}"
                ]
              }
            }
          ]
