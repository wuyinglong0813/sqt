{
  "info": {
    "name": "TradePass 当前法大大接口",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "依据仓库及 fasc-openapi-java-sdk 5.8.7.0428.3 生成。19 个服务商 API + PDF PUT + 11 个商签通业务入口。请逐项发送，不要全量运行创建/撤回/作废文件夹。凭据留空，签名在本地自动计算。"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const CryptoJS = require('crypto-js');",
          "const url = pm.request.url.toString();",
          "if (url.startsWith('{{fdd_base_url}}')) {",
          "  const get = key => pm.variables.get(key);",
          "  if (!get('fdd_app_id') || !get('fdd_app_secret')) throw new Error('请填写 fdd_app_id 和 fdd_app_secret');",
          "  const tokenRequest = url.includes('/service/get-access-token');",
          "  const headers = {",
          "    'X-FASC-App-Id': get('fdd_app_id'),",
          "    'X-FASC-Api-SubVersion': '5.1',",
          "    'X-FASC-Sign-Type': 'HMAC-SHA256',",
          "    'X-FASC-Timestamp': String(Date.now()),",
          "    'X-FASC-Nonce': pm.variables.replaceIn('{{$guid}}').replace(/-/g, '')",
          "  };",
          "  if (tokenRequest) headers['X-FASC-Grant-Type'] = 'client_credential';",
          "  else {",
          "    if (!get('fdd_access_token')) throw new Error('请先执行获取访问令牌');",
          "    headers['X-FASC-AccessToken'] = get('fdd_access_token');",
          "  }",
          "  const signing = Object.assign({}, headers);",
          "  if (!tokenRequest) {",
          "    const field = pm.request.body.urlencoded.find(p => p.key === 'bizContent' && !p.disabled);",
          "    let body = pm.variables.replaceIn(field.value);",
          "    if (/{{[^}]+}}/.test(body)) throw new Error('请求中存在未填写的变量');",
          "    const data = JSON.parse(body);",
          "    if (data.callbackUrl === '') delete data.callbackUrl;",
          "    body = JSON.stringify(data);",
          "    pm.request.body.urlencoded.upsert({key: 'bizContent', value: body});",
          "    signing.bizContent = body;",
          "  }",
          "  const sorted = Object.keys(signing).filter(k => String(signing[k]).trim()).sort().map(k => k + '=' + signing[k]).join('&');",
          "  const hash = CryptoJS.SHA256(sorted).toString(CryptoJS.enc.Hex);",
          "  const key = CryptoJS.HmacSHA256(headers['X-FASC-Timestamp'], get('fdd_app_secret'));",
          "  headers['X-FASC-Sign'] = CryptoJS.HmacSHA256(hash, key).toString(CryptoJS.enc.Hex);",
          "  Object.entries(headers).forEach(([key,value]) => pm.request.headers.upsert({key,value}));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 访问令牌",
      "item": [
        {
          "name": "获取访问令牌",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": "{{fdd_base_url}}/service/get-access-token",
            "description": "",
            "body": {
              "mode": "urlencoded",
              "urlencoded": []
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('法大大调用成功', () => pm.expect(String(r.code)).to.eql('100000'));",
                  "if (String(r.code) === '100000' && r.data) {",
                  "  if (r.data.accessToken !== undefined && r.data.accessToken !== null) pm.environment.set('fdd_access_token', String(r.data.accessToken));",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
